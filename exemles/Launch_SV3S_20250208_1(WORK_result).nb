       RowBox[{"px", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"inert2x", " ", "inertx2", " ", 
            RowBox[{"(", 
             RowBox[{"resist1x", "-", 
              RowBox[{"p1", " ", "rho"}]}], ")"}]}], "+", 
           RowBox[{"inert1x", " ", "inertx2", " ", 
            RowBox[{"(", 
             RowBox[{"resist2x", "-", 
              RowBox[{"p2", " ", "rho"}]}], ")"}]}], "+", 
           RowBox[{"inert1x", " ", "inert2x", " ", 
            RowBox[{"(", 
             RowBox[{"resistx2", "+", 
              RowBox[{"p3", " ", "rho"}]}], ")"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"inert1x", " ", "inert2x"}], "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"inert1x", "+", "inert2x"}], ")"}], " ", "inertx2"}]}],
             ")"}], " ", "rho"}], ")"}]}]}], ";", "\n", "px"}], "\n", "}"}]}],
     "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Code",

         RowBox[{"g0", "=", "1"}], ",", 
         RowBox[{"g0", "=", "980.665"}]}], "]"}], ";", "\n", 
       RowBox[{"PI", " ", "=", " ", 
        RowBox[{"P2", "/", "P1"}]}], ";", "\n", 
       RowBox[{"PIcrit", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "/", 
           RowBox[{"(", 
            RowBox[{"k", "+", "1"}], ")"}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"k", "/", 
           RowBox[{"(", 
            RowBox[{"k", "-", "1"}], ")"}]}], ")"}]}]}], ";", "\n", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"PI", " ", "<", " ", "PIcrit"}], ",", 
         RowBox[{"return", " ", "=", " ", "True"}], ",", " ", 
         RowBox[{"return", " ", "=", " ", "False"}]}], "]"}], ";", "\t\t", 
       "\n", "return"}]}], "]"}]}], ";"}]}]], "Code",

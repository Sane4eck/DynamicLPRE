Cell[CellGroupData[{

Cell["create Dict fo save results", "Subsection",ExpressionUUID->"63fc8178-f516-4a3c-bc26-e6c7d25ead27"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"defCreateDict", "[", "listVarStr_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dictBase", ",", "dictResult", ",", "listVar"}], "}"}], ",", 
      RowBox[{"{", "\n", 
       RowBox[{
        RowBox[{"listVar", "=", 
         RowBox[{"StringSplit", "[", 
          RowBox[{"listVarStr", ",", "\"\<,\>\""}], "]"}]}], ";", "\n", 
        RowBox[{"dictBase", " ", "=", " ", 
         RowBox[{
          RowBox[{"Reap", "[", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"Sow", "[", 
              RowBox[{
              "\"\<\\\"\>\"", "<>", "i", "<>", "\"\<\\\"\>\"", "<>", 
               "\"\<->\>\"", "<>", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"StringTake", "[", 
                   RowBox[{"i", ",", "1"}], "]"}], "==", " ", "\"\<p\>\""}], 
                 ",", 
                 RowBox[{
                 "i", "<>", 
                  "\"\<*\\!\\(\\*SuperscriptBox[\\(10\\), \\(-5\\)]\\)\>\""}],
                  ",", "i"}], "]"}], "<>", "\"\<,\>\""}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "listVar"}], "}"}]}], "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";", "\n", 
        RowBox[{"dictResult", " ", "=", 
         RowBox[{
         "\"\<<|\>\"", "<>", 
          "\"\<\\\"1_time\\\"\[Rule]TIME,\\\"2_j\\\"\[Rule]j,\>\"", "<>", 
          "dictBase", "<>", 
          "\"\<\\\"z_time\\\"\[Rule]TIME,\\\"z_j\\\"\[Rule]j\>\"", "<>", 
          "\"\<|>\>\""}]}], ";", "\n", "dictResult"}], "\n", "}"}]}], "]"}], 
    "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.9405649350285997`*^9, 3.940564935775761*^9}},
 CellLabel->
  "In[1147]:=",ExpressionUUID->"72185908-a1f1-43d1-83a1-4b362c71cabf"],


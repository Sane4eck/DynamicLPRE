Cell[BoxData[
 RowBox[{
  RowBox[{"funcPSpltNoComp", "[", 
   RowBox[{
   "p1_", ",", "p2_", ",", "p3_", ",", "rho_", ",", "inert1x_", ",", 
    "inert2x_", ",", "inertx2_", ",", "resist1x_", ",", "resist2x_", ",", 
    "resistx2_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Block", "[", 

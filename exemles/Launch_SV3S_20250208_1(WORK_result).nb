            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"k", "+", "1"}], ")"}], "/", "k"}], "-", "1"}], 
             ")"}]}]}]}], ")"}]}]}], ";", "\n", 
      RowBox[{"c", "=", 
       RowBox[{"df", "/", "p1"}]}], ";", "\n", 
      RowBox[{
       RowBox[{"-", "f"}], "/", "c"}]}]}], "]"}]}]}]], "Code",
 CellLabel->
  "In[1142]:=",ExpressionUUID->"8db1dc9f-1587-4418-bf08-a0aba36d6d3e"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"defCheckCritNozzle", "[", 
     RowBox[{"P1_", ",", "P2_", ",", " ", "k_"}], "]"}], ":=", 
    RowBox[{"Block", "[", " ", 
     RowBox[{
      RowBox[{"{", 

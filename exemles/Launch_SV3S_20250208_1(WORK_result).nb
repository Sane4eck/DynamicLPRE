Cell[CellGroupData[{

Cell["calculation of the degree of expansion of the nozzle", "Subsection",ExpressionUUID->"6e26edde-100c-4b2e-8acd-1b8ef74706c9"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"FuncQ", "[", 
    RowBox[{"k_", ",", "p1_", ",", "p2_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "q", "}"}], ",", "\n", 
     RowBox[{"q", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "+", "1"}], ")"}], "/", "2"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"k", "-", "1"}], ")"}]}], ")"}]}], "*", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "+", "1"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"k", "-", "1"}], ")"}]}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p2", "/", "p1"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"2", "/", "k"}], ")"}]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p2", "/", "p1"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"k", "+", "1"}], ")"}], "/", "k"}], ")"}]}]}], ")"}]}],
         "]"}]}]}]}], "]"}]}]}]], "Code",
 CellLabel->

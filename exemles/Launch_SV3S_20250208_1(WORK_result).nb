Cell[CellGroupData[{

Cell["plot graphs compliance", "Subsection",ExpressionUUID->"007ae8d3-389f-410f-ba03-488cb603f1fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"defCompCavPump", "[", 
   RowBox[{
   "pltLabel_", ",", "rangePressure_", ",", "rangeMassFlow_", ",", 
    "interpRho_", ",", "defCavitation_", ",", "TTank_", ",", "DKSI_", ",", 
    "liniarModel_", ",", "dAugerOuterPump_", ",", "dHubAugerPump_", ",", 
    "dPipeInPump_", ",", "rpm_", ",", "nPump_", ",", "pitchPump_", ",", 
    "lengthAugerPump_", ",", "numAugerBladesPump_", ",", "pressureVapor_", 
    ",", "pltRange_", ",", "minCompCavPump_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "compPump", ",", "rho", ",", "B1", ",", "B2", ",", "pCp", ",", "qab", 
       ",", "TK", ",", "J", ",", "coefH", ",", "QAB", ",", "dictCompCavFu", 
       ",", "nameListColor"}], "}"}], ",", 
     RowBox[{"{", "\n", "\n", 
      RowBox[{
       RowBox[{"dictCompCavFu", " ", "=", " ", 
        RowBox[{"<|", "|>"}]}], ";", "\n", 
       RowBox[{"nameListColor", "=", 
        RowBox[{"{", "}"}]}], ";", "\n", 
       RowBox[{"Do", "[", "\n", 
        RowBox[{
         RowBox[{
          RowBox[{"compPump", "=", " ", 
           RowBox[{
            RowBox[{"Reap", "[", 
             RowBox[{"Do", "[", "\n", 
              RowBox[{
               RowBox[{
                RowBox[{"rho", " ", "=", " ", 
                 RowBox[{"interpRho", "[", 
                  RowBox[{"pressure", ",", "TTank"}], "]"}]}], ";", "\n", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                  "B1", ",", "B2", ",", "pCp", ",", "qab", ",", "TK", ",", 
                   "J", ",", "coefH", ",", "QAB"}], "}"}], "=", 
                 RowBox[{"defCavitation", " ", "[", 
                  RowBox[{
                  "DKSI", ",", "massFlow", ",", "pressure", ",", 
                   "liniarModel", ",", "dAugerOuterPump", ",", 
                   "dHubAugerPump", ",", "dPipeInPump", ",", "rpm", ",", 
                   "nPump", ",", "pitchPump", ",", "rho", ",", 
                   "lengthAugerPump", ",", "numAugerBladesPump", ",", 
                   "pressureVapor"}], "]"}]}], ";", "\n", 
                RowBox[{"Sow", "[", 
                 RowBox[{
                  RowBox[{"-", "rho"}], "/", "B1"}], "]"}]}], "\n", ",", 
               RowBox[{"{", 
                RowBox[{"pressure", ",", "rangePressure"}], "}"}]}], "]"}], 
             "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";", "\n", 
          RowBox[{
           RowBox[{"dictCompCavFu", "[", 
            RowBox[{"\"\<massFlow_\>\"", "<>", 
             RowBox[{"ToString", "[", "massFlow", "]"}], "<>", 
             "\"\<_kg/s\>\""}], "]"}], "=", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"rangePressure", ",", "compPump"}], "}"}], "]"}]}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"massFlow", ",", "rangeMassFlow"}], "}"}]}], "]"}], ";", 
       "\n", "\n", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"nameListColor", ",", 
           RowBox[{"RGBColor", "[", 
            RowBox[{"i", ",", "0", ",", "0.5"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "1", ",", 
           RowBox[{"1", "/", 
            RowBox[{"Length", "[", "rangeMassFlow", "]"}]}]}], "}"}]}], "]"}],
        ";", "\n", "\n", 
       RowBox[{"Show", "[", 
        RowBox[{
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"Values", "[", "dictCompCavFu", "]"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"Keys", "[", "dictCompCavFu", "]"}]}], ",", 
           RowBox[{"PlotStyle", "->", " ", "nameListColor"}], ",", " ", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"PlotRange", "->", " ", "pltRange"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<pressure\>\"", ",", "\"\<compliance\>\""}], "}"}]}],
            ",", 
           RowBox[{"PlotLabel", "->", "pltLabel"}]}], "]"}], ",", "\n", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"rangePressure", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", "minCompCavPump"}], 
              "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"rangePressure", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], ",", "minCompCavPump"}], 
              "}"}]}], "}"}], ",", 
           RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "]"}]}], "\n", 
      "}"}]}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Code",
 CellChangeTimes->{{3.9405649208095903`*^9, 3.940564921397579*^9}},
 CellLabel->
  "In[1145]:=",ExpressionUUID->"97cf6634-ab8c-4fcb-a911-d5538e90c66b"]

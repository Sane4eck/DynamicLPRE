          RowBox[{"msum", " ", "*", " ", "CpTotal"}], ")"}]}]}], ";", "\n", 
       RowBox[{"koutput", " ", "=", " ", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"listK", "*", "listM"}], "]"}], "/", "msum"}]}], ";", "\n", 
       RowBox[{"Routput", " ", "=", " ", 

           RowBox[{
            RowBox[{"(", 
             RowBox[{"t", "-", "t0"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"t1", "-", "t0"}], ")"}]}]}]}]}]}], "]"}], ";", "\n", 
